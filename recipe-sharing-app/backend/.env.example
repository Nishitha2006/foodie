# Copy this file to .env and fill in real values. Never commit .env.

PORT=5050
CLIENT_URL=http://localhost:5173

# Local MongoDB (Homebrew) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/recipe-sharing-app

# Long random string used to sign login tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# AI Recipe Finder (optional). Get a free key at https://aistudio.google.com/apikey
# Leave empty to use the database-matching fallback.
GEMINI_API_KEY=
# gemini-3.8-flash is the default. For a cheaper option, use gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash
